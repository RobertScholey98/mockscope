{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response with a status code the spec does not document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "delay": {
      "type": "integer",
      "minimum": 0
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "body": {}
  }
}
